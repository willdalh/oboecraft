{
  "schemaVersion": 1,
  "id": "oboecraft",
  "version": "${version}",
  "name": "Oboecraft",
  "description": "Learn Japanese through spaced repetition on Minecraft items.",
  "authors": ["Oboecraft contributors"],
  "contact": {
    "sources": "https://github.com/willdalh/oboecraft",
    "issues": "https://github.com/willdalh/oboecraft/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.willdalh.oboecraft.fabric.Oboecraft"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}

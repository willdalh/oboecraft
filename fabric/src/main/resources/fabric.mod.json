{
  "schemaVersion": 1,
  "id": "oboecraft",
  "version": "${version}",
  "name": "Oboecraft",
  "description": "Learn Japanese with spaced repetition on the items in the game.",
  "authors": [
    "willdalh",
    "KatoAb"
  ],
  "contact": {
    "homepage": "https://github.com/willdalh/oboecraft",
    "sources": "https://github.com/willdalh/oboecraft"
  },
  "license": [
    "MIT",
    "CC-BY-SA-4.0",
    "CC-BY-2.1-JP",
    "LicenseRef-VOICEVOX"
  ],
  "icon": "assets/oboecraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.willdalh.oboecraft.fabric.OboecraftMod"
    ],
    "client": [
      "io.github.willdalh.oboecraft.fabric.client.OboecraftClient"
    ],
    "modmenu": [
      "io.github.willdalh.oboecraft.fabric.client.settings.ModMenuIntegration"
    ]
  },
  "mixins": [
    "oboecraft.mixins.json",
    {
      "config": "oboecraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
